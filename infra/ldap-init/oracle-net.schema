# Minimal subset of the Oracle Net directory-naming schema used by the JDBC
# thin driver to resolve jdbc:oracle:thin:@ldap:// URLs.
attributetype ( 2.16.840.1.113894.3.1.12 NAME 'orclNetDescName'
    EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
attributetype ( 2.16.840.1.113894.3.1.13 NAME 'orclNetDescString'
    EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
objectclass ( 2.16.840.1.113894.7.2.3 NAME 'orclContext'
    SUP top STRUCTURAL MUST cn )
objectclass ( 2.16.840.1.113894.3.2.5 NAME 'orclNetService'
    SUP top STRUCTURAL MUST cn MAY ( orclNetDescName $ orclNetDescString $ description ) )
