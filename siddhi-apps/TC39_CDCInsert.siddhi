@App:name('TC39_CDCInsert')
@App:description('CDC listening mode: Debezium binlog INSERT capture (one connector avoids JMX conflict)')

@source(type='cdc',
        url='jdbc:mysql://localhost:3307/si_test_db?useSSL=false&allowPublicKeyRetrieval=true',
        mode='listening',
        jdbc.driver.name='com.mysql.cj.jdbc.Driver',
        username='sitest',
        password='sitest123',
        table.name='cdc_listen_table',
        operation='insert',
        @map(type='keyvalue'))
define stream CDCInsertStream (order_id int, product string, quantity int, price double);

@sink(type='log', prefix='[TC39-INSERT]')
define stream InsertLogStream (order_id int, product string, quantity int, price double);

from CDCInsertStream
select order_id, product, quantity, price
insert into InsertLogStream;
