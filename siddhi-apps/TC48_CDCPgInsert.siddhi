@App:name('TC48_CDCPgInsert')
@App:description('PostgreSQL CDC listening mode: Debezium logical replication INSERT capture (one connector per app avoids JMX MBean conflict)')

@source(type='cdc',
        url='jdbc:postgresql://localhost:5433/si_test_db',
        mode='listening',
        jdbc.driver.name='org.postgresql.Driver',
        username='sitest',
        password='sitest123',
        table.name='public.cdc_listen_table_pg',
        connector.properties='plugin.name=pgoutput',
        operation='insert',
        @map(type='keyvalue'))
define stream CDCInsertStream (order_id int, product string, quantity int, price double);

@sink(type='log', prefix='[TC48-INSERT]')
define stream InsertLogStream (order_id int, product string, quantity int, price double);

from CDCInsertStream
select order_id, product, quantity, price
insert into InsertLogStream;
