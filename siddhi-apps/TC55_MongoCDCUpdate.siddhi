@App:name('TC55_MongoCDCUpdate')
@App:description('TC55: capture MongoDB update change events through the CDC extension')

@source(type='cdc',
        url='jdbc:mongodb://rs0/localhost:27017/si_test_db',
        username='sitest',
        password='sitest123',
        table.name='TC55_MongoCDC',
        topic.prefix='TC55MongoCDCUpdate',
        operation='update',
        @map(type='keyvalue'))
define stream MongoUpdateStream (id string, tier string);

@sink(type='log', prefix='[TC55-UPDATE]')
define stream MongoUpdateLogStream (id string, tier string);

@info(name='TC55-log-update')
from MongoUpdateStream
select id, tier
insert into MongoUpdateLogStream;
