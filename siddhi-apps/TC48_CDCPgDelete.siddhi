@App:name('TC48_CDCPgDelete')
@App:description('PostgreSQL CDC listening mode: Debezium logical replication DELETE capture (one connector per app avoids JMX MBean conflict)')

@source(type='cdc',
        url='jdbc:postgresql://localhost:5433/si_test_db',
        mode='listening',
        jdbc.driver.name='org.postgresql.Driver',
        username='sitest',
        password='sitest123',
        table.name='public.cdc_listen_table_pg',
        connector.properties='plugin.name=pgoutput',
        operation='delete',
        @map(type='keyvalue'))
define stream CDCDeleteStream (before_order_id int, before_product string,
                               before_quantity int, before_price double);

@sink(type='log', prefix='[TC48-DELETE]')
define stream DeleteLogStream (before_order_id int, before_product string);

from CDCDeleteStream
select before_order_id, before_product
insert into DeleteLogStream;
