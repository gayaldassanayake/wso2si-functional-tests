@App:name('TC57_CronTriggerA')
@App:description('Cron trigger A: shares the trigger id T with the other TC57 app')

/*
Tests: cron triggers with the same id in two apps, Quartz scheduler shutdown when idle (BNYMDMAPROD-220).
Port : none
Deps : none
*/

define trigger T at '*/2 * * * * ?';

@sink(type='log', prefix='[TC57-A]')
define stream TickStream (triggered_time long);

from T
select triggered_time
insert into TickStream;
