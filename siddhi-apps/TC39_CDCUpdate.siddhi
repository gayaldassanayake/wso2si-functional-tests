@App:name('TC39_CDCUpdate')
@App:description('CDC listening mode: Debezium binlog UPDATE capture (one connector avoids JMX conflict)')

@source(type='cdc',
        url='jdbc:mysql://localhost:3307/si_test_db?useSSL=false&allowPublicKeyRetrieval=true',
        mode='listening',
        jdbc.driver.name='com.mysql.cj.jdbc.Driver',
        username='sitest',
        password='sitest123',
        table.name='cdc_listen_table',
        operation='update',
        @map(type='keyvalue'))
define stream CDCUpdateStream (order_id int, product string, quantity int, price double,
                               before_order_id int, before_product string,
                               before_quantity int, before_price double);

@sink(type='log', prefix='[TC39-UPDATE]')
define stream UpdateLogStream (order_id int, product string, quantity int, price double);

from CDCUpdateStream
select order_id, product, quantity, price
insert into UpdateLogStream;
