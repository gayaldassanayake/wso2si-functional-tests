# =============================================================================
# WSO2 Streaming Integrator 4.3.2 Test Suite Configuration
# =============================================================================
# Set SI_HOME to your installed SI binary directory before running tests:
#   export SI_HOME=/path/to/wso2si-4.3.2
# Or pass inline:
#   SI_HOME=/path/to/wso2si-4.3.2 ./run_all_tests.sh

SI_HOME="${SI_HOME:-/tmp/si-release-pack/wso2si-4.4.0}"

# Derived paths (override if your SI layout differs)
SI_SIDDHI_DIR="${SI_HOME}/wso2/server/deployment/siddhi-files"
SI_LOG="${SI_HOME}/wso2/server/logs/carbon.log"

# SI server ports (per deployment.yaml defaults)
SI_HTTP_PORT=9090
SI_STORE_API_PORT=7070
SI_STORE_API_USER="admin"
SI_STORE_API_PASS="admin"

# Docker Compose infrastructure
KAFKA_BOOTSTRAP="127.0.0.1:9092"
KAFKA_CONTAINER="si-test-kafka"
MYSQL_HOST="localhost"
MYSQL_PORT=3307
MYSQL_USER="sitest"
MYSQL_PASS="sitest123"
MYSQL_DB="si_test_db"
MYSQL_CONTAINER="si-test-mysql"
RABBITMQ_HOST="localhost"
RABBITMQ_PORT=5672
RABBITMQ_CONTAINER="si-test-rabbitmq"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_CONTAINER="si-test-redis"

# Test tuning
DEPLOY_WAIT_SECONDS=8        # seconds to wait after copying a Siddhi app
LOG_TAIL_LINES=2000          # lines of log to scan for assertions
PATTERN_WAIT_SECONDS=5       # seconds to wait for patterns to fire
WINDOW_WAIT_SECONDS=12       # seconds to wait for time windows to expire

# File source test file (must be accessible by SI server process)
FILE_SOURCE_PATH="/tmp/si-test-sales.csv"

# =============================================================================
# Kubernetes live tests (TC28-TC34) — requires a running cluster + Envoy Gateway
# =============================================================================
K8S_TEST_NAMESPACE="wso2-si-k8s-test"
K8S_RELEASE_NAME="si-k8s-test"
K8S_HOSTNAME="si.wso2.com"
K8S_TLS_SECRET="si-gateway-tls"
K8S_GATEWAY_NAME="si-gateway"
K8S_GATEWAY_CLASS="eg"
K8S_GATEWAY_PORT=8443      # listener port (443 conflicts with Traefik on Rancher Desktop)
K8S_ENVOY_NS="envoy-gateway-system"
K8S_RESOURCE_TIMEOUT=60    # seconds to wait for resource creation
K8S_GATEWAY_TIMEOUT=120    # seconds to wait for Gateway/HTTPRoute conditions
K8S_POD_TIMEOUT=360        # seconds to wait for SI pod ready (180s probes + buffer)
K8S_PF_PORT=18443          # local port for kubectl port-forward

# =============================================================================
# Helm chart tests (TC19-TC27) — no running SI server required
# =============================================================================
# Path to the wso2/helm-si chart directory
HELM_SI_CHART="${HELM_SI_CHART:-/Users/nipunal/work/repositories/support-rotation/helm-si}"

# HTTP source ports (each app gets a unique port to allow concurrent deployment)
PORT_TC01=8099
PORT_TC02=8100
PORT_TC03=8101
PORT_TC04=8102
PORT_TC05=8103
PORT_TC06=8104
PORT_TC07=8105
# TC08 uses Kafka (no HTTP port)
PORT_TC09=8106
PORT_TC10=8107
# TC11 uses CDC (no HTTP port for source)
# TC12 uses File source (no HTTP port)
PORT_TC13=8108
PORT_TC14=8109
PORT_TC15=8110
PORT_TC16=8111
PORT_TC17=8112
PORT_TC18=8113
PORT_TC40=8114   # TC40: File sink (HTTP trigger)
PORT_TC41=8115   # TC41: gRPC echo client (HTTP trigger)
PORT_TC42=8116   # TC42: gRPC consume sender (HTTP trigger)
PORT_TC43_TCP=8117   # TC43: Thrift sender via TCP (tcp://localhost:7611)
PORT_TC43_SSL=8118   # TC43: Thrift sender via SSL (ssl://localhost:7711)
PORT_TC44=8119       # TC44: HTTP request/response trigger (http source)
PORT_TC44_ECHO=8120  # TC44: http-service echo endpoint
# TC45 uses RabbitMQ (no HTTP port for source)
PORT_TC46=8121       # TC46: Redis store HTTP source
PORT_TC47=8122       # TC47: XML emit trigger (http source)
PORT_TC47_ECHO=8123  # TC47: XML self-loop echo receiver
# TC39 uses CDC (no HTTP port for source)
GRPC_PORT_TC41=8283   # TC41: gRPC server (grpc-service)
GRPC_PORT_TC42=8183   # TC42: gRPC consume receiver (grpc source)

# File sink output path (TC40)
FILE_SINK_PATH_TC40="/tmp/si-test-sink-tc40.csv"

# Distribution tool test settings (TC35–TC38)
# TC35 must be run standalone before starting SI (it starts/stops its own server instance)
TOOLS_PACK_HOME="${TOOLS_PACK_HOME:-/tmp/si-release-pack/wso2si-4.4.0}"
TOOLS_TEST_TMP="/tmp/si-tools-test"
